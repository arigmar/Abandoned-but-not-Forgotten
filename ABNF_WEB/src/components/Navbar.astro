---
import { SITE } from '../config/site';
import { formatUtcClock } from '../lib/silence';

const initialUtc = formatUtcClock(Date.parse(SITE.baseDate));
---

<header
  id="mission-navbar"
  class="fixed inset-x-0 top-0 z-40 border-b border-[var(--color-border)] bg-[color:rgba(9,13,22,0.94)] backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
    <a
      href="#signal"
      class="flex shrink-0 items-center gap-2.5 text-[var(--color-text-primary)] no-underline"
    >
      <span
        class="inline-flex h-5 w-5 items-center justify-center border border-[var(--color-turquoise-border)] bg-[var(--color-slate)]"
        aria-hidden="true"
      >
        <span class="h-1.5 w-1.5 bg-[var(--color-turquoise)]"></span>
      </span>
      <span class="font-mono-telemetry text-xs font-bold tracking-[0.22em] uppercase">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Mission phases" class="hidden md:flex items-center gap-1 lg:gap-2">
      {
        SITE.sections.map((section) => (
          <a
            href={`#${section.id}`}
            data-nav-link={section.id}
            class="group flex shrink-0 items-center gap-1.5 border border-transparent px-2.5 py-1.5 font-mono-telemetry text-[11px] tracking-[0.12em] text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-border)] hover:text-[var(--color-text-primary)]"
          >
            <span class="text-[var(--color-turquoise)] opacity-80">{section.code}</span>
            <span>{section.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <div class="hidden sm:flex items-center gap-1.5 font-mono-telemetry text-[11px] tracking-[0.12em] text-[var(--color-text-secondary)]">
        <span
          class="inline-block h-2 w-2 rounded-full bg-[var(--color-turquoise)]"
          aria-hidden="true"
        ></span>
        <span>UPLINK</span>
      </div>
      <div class="border border-[var(--color-border)] bg-[var(--color-slate)] px-2.5 py-1">
        <span
          id="nav-utc-clock"
          aria-hidden="true"
          class="font-mono-telemetry text-[11px] tracking-[0.08em] text-[var(--color-text-primary)]"
        >
          {initialUtc.mono}
        </span>
        <span id="nav-utc-sr" class="sr-only">
          {initialUtc.accessible}
        </span>
      </div>
    </div>
  </div>

  <!-- Compact mobile phase strip so all 5 anchors fit cleanly at 360px without horizontal overflow -->
  <nav
    aria-label="Mission phases mobile"
    class="grid grid-cols-5 border-t border-[var(--color-border)] bg-[var(--color-void)] md:hidden"
  >
    {
      SITE.sections.map((section) => (
        <a
          href={`#${section.id}`}
          data-nav-link={section.id}
          class="flex flex-col items-center justify-center py-1.5 font-mono-telemetry text-[10px] tracking-[0.08em] text-[var(--color-text-secondary)] transition-colors"
        >
          <span class="text-[var(--color-turquoise)]">{section.code}</span>
          <span>{section.label}</span>
        </a>
      ))
    }
  </nav>
</header>

<style>
  a[data-nav-link][aria-current='location'] {
    color: var(--color-turquoise);
    border-color: var(--color-turquoise-border);
    background-color: var(--color-turquoise-dim);
  }
</style>

<script>
  import { formatUtcClock, subscribeMissionClock } from '../lib/silence';

  const clockEl = document.getElementById('nav-utc-clock');
  const srClockEl = document.getElementById('nav-utc-sr');
  let lastSrMinute = '';

  const updateUtc = (nowMs: number) => {
    const formatted = formatUtcClock(nowMs);
    if (clockEl) clockEl.textContent = formatted.mono;
    const minuteKey = formatted.mono.slice(0, 16);
    if (srClockEl && minuteKey !== lastSrMinute) {
      lastSrMinute = minuteKey;
      srClockEl.textContent = formatted.accessible;
    }
  };

  updateUtc(Date.now());
  subscribeMissionClock(updateUtc);

  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]'));
  const sectionIds = [...new Set(navLinks.map((a) => a.dataset.navLink).filter(Boolean))] as string[];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  const setActiveNav = (activeId: string) => {
    for (const link of navLinks) {
      if (link.dataset.navLink === activeId) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    }
  };

  setActiveNav('signal');

  if ('IntersectionObserver' in window && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]?.target?.id) {
          setActiveNav(visible[0].target.id);
        }
      },
      {
        rootMargin: '-25% 0px -55% 0px',
        threshold: [0.1, 0.25, 0.5],
      },
    );

    for (const section of sections) {
      observer.observe(section);
    }
  }
</script>
