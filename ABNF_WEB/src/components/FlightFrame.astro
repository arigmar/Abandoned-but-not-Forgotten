---
import { SITE } from '../config/site';
import { withBase } from '../lib/base-path';

const aspectClass = SITE.gameAspectRatio === '4:3' ? 'aspect-[4/3]' : 'aspect-video';

const missions = {
  mars: {
    id: 'mars',
    label: 'Mars · 3.72 m/s²',
    heading: 'Planetary Flight — Moon & Mars',
    summary:
      'Pilot the historian drone in open space where both the Moon and Mars are active targets. Fly to Mars to descend under 3.72 m/s² gravity, or steer toward the Moon instead—then press Launch to Orbit [L] after landing to blast back into space and visit the other world.',
    transitHref: withBase('/vuelo'),
    transitDetail: 'Open space flight: reach either Mars or the Moon ([1] / [2] switch lock).',
    landingHref: withBase('/aterrizaje'),
    landingDetail: 'Powered landing under Martian gravity (3.72 m/s²) + Launch to Orbit [L].',
    iframeTitle: 'Orbital Flight — Moon and Mars mission',
  },
  moon: {
    id: 'moon',
    label: 'Moon · 1.62 m/s²',
    heading: 'Planetary Flight — Moon & Mars',
    summary:
      'Pilot the historian drone in open space with target lock pre-set to the Moon. Land on cratered gray regolith beneath Earthrise under 1.62 m/s² gravity, then blast back to orbit [L] anytime to change course for Mars.',
    transitHref: withBase('/vuelo-luna'),
    transitDetail: 'Open space flight locked on the Moon (switchable mid-flight to Mars).',
    landingHref: withBase('/aterrizaje-luna'),
    landingDetail: 'Powered landing on lunar regolith (1.62 m/s²) + Launch to Orbit [L].',
    iframeTitle: 'Orbital Flight — Moon and Mars mission',
  },
};

const initial = missions.mars;

const stages = [
  {
    code: 'STAGE 01',
    label: 'Transit',
    detailId: 'flight-stage1-detail',
    detail: initial.transitDetail,
    hrefId: 'flight-stage1-link',
    href: initial.transitHref,
    action: 'Launch stage 1',
  },
  {
    code: 'STAGE 02',
    label: 'Descent',
    detailId: 'flight-stage2-detail',
    detail: initial.landingDetail,
    hrefId: 'flight-stage2-link',
    href: initial.landingHref,
    action: 'Open stage 2 directly',
  },
];
---

<section
  id="flight"
  class="mt-6 space-y-5 border border-[var(--color-border-strong)] bg-[var(--color-void)] p-4 sm:p-6"
  aria-labelledby="flight-cta-heading"
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="max-w-2xl space-y-2">
      <p class="font-mono-telemetry text-[11px] tracking-[0.16em] text-[var(--color-turquoise)] uppercase">
        Flight mission · Three.js · Two-stage expedition
      </p>
      <h3
        id="flight-cta-heading"
        class="font-serif-display text-3xl tracking-tight text-[var(--color-text-primary)]"
      >
        {initial.heading}
      </h3>
      <p id="flight-summary" class="text-xs leading-relaxed text-[var(--color-text-secondary)] sm:text-sm">
        {initial.summary}
      </p>
    </div>

    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <button
        type="button"
        id="flight-launch"
        class="inline-flex cursor-pointer items-center gap-2 border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-4 py-2.5 font-mono-telemetry text-xs font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase transition-colors hover:border-[var(--color-turquoise)]"
        aria-controls="flight-stage"
      >
        Launch mission
        <span aria-hidden="true">&rarr;</span>
      </button>
      <a
        id="flight-fullscreen"
        href={initial.transitHref}
        target="_top"
        class="inline-flex items-center border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-3 py-2.5 font-mono-telemetry text-[11px] tracking-[0.1em] text-[var(--color-text-primary)] uppercase transition-colors hover:border-[var(--color-turquoise)] hover:text-[var(--color-turquoise)]"
      >
        Full screen
      </a>
    </div>
  </div>

  <!-- Target Body Selector (Mars | Moon) -->
  <div
    class="flex flex-wrap items-center gap-2 border-t border-[var(--color-border)] pt-3"
    role="group"
    aria-label="Flight mission destination"
  >
    <span class="font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-text-secondary)] uppercase">
      Destination:
    </span>
    <button
      type="button"
      data-flight-target="mars"
      aria-pressed="true"
      class="cursor-pointer border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-3 py-1.5 font-mono-telemetry text-[11px] tracking-[0.1em] text-[var(--color-turquoise)] uppercase transition-colors"
    >
      {missions.mars.label}
    </button>
    <button
      type="button"
      data-flight-target="moon"
      aria-pressed="false"
      class="cursor-pointer border border-[var(--color-border)] bg-[var(--color-slate)] px-3 py-1.5 font-mono-telemetry text-[11px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase transition-colors hover:border-[var(--color-turquoise-border)] hover:text-[var(--color-text-primary)]"
    >
      {missions.moon.label}
    </button>
  </div>

  <!-- Stage Overview Cards (Variant A Circuit) -->
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    {
      stages.map((stage) => (
        <div class="flex flex-col justify-between border border-[var(--color-border)] bg-[var(--color-slate)] p-3">
          <div>
            <p class="font-mono-telemetry text-[10px] tracking-[0.14em] text-[var(--color-text-secondary)] uppercase">
              {stage.code}
            </p>
            <p class="mt-0.5 font-mono-telemetry text-xs font-bold tracking-[0.1em] text-[var(--color-text-primary)] uppercase">
              {stage.label}
            </p>
            <p id={stage.detailId} class="mt-1 text-xs leading-relaxed text-[var(--color-text-secondary)]">
              {stage.detail}
            </p>
          </div>
          <a
            id={stage.hrefId}
            href={stage.href}
            target="_top"
            class="mt-2.5 inline-flex items-center gap-1.5 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-turquoise)] uppercase hover:underline"
          >
            <span>{stage.action}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      ))
    }
  </div>

  <!-- Lazy-Mounted Embedded Mission Frame (Variant B Embedded) -->
  <div
    id="flight-stage"
    class={`relative w-full overflow-hidden border border-[var(--color-border)] bg-[var(--color-void)] ${aspectClass}`}
    data-state="standby"
    data-src={initial.transitHref}
    data-iframe-title={initial.iframeTitle}
  >
    <div
      id="flight-standby"
      class="flex h-full w-full flex-col items-center justify-center gap-3 bg-reticle-grid p-6 text-center"
    >
      <p class="font-mono-telemetry text-[11px] tracking-[0.16em] text-[var(--color-turquoise)] uppercase">
        Flight module · Standby
      </p>
      <p class="max-w-sm text-xs leading-relaxed text-[var(--color-text-secondary)]">
        Choose Mars or Moon above, then press Launch mission to stream the 3D transit and descent
        scenes inline — or open Full screen at full viewport height.
      </p>
      <p class="font-mono-telemetry text-[10px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase">
        [W / Space] Thrust · [S] Brake · [A / D] Turn · [1 / 2] Target · [G] Auto-cruise · [L] Orbit Takeoff
      </p>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-border)] pt-3 font-mono-telemetry text-[10px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase">
    <span id="flight-state">Status: Mission standby</span>
    <span id="flight-hint">Launch to load the 3D module · Back to museum inside the mission returns here</span>
  </div>

  <script id="flight-missions-data" type="application/json" set:html={JSON.stringify(missions)} />
</section>

<script>
  type TargetId = 'mars' | 'moon';
  interface FlightMissionMeta {
    id: TargetId;
    label: string;
    heading: string;
    summary: string;
    transitHref: string;
    transitDetail: string;
    landingHref: string;
    landingDetail: string;
    iframeTitle: string;
  }

  const missionsEl = document.getElementById('flight-missions-data');
  const missions: Record<TargetId, FlightMissionMeta> | null = missionsEl?.textContent
    ? (JSON.parse(missionsEl.textContent) as Record<TargetId, FlightMissionMeta>)
    : null;

  const stage = document.getElementById('flight-stage') as HTMLElement | null;
  const standby = document.getElementById('flight-standby');
  const launchBtn = document.getElementById('flight-launch') as HTMLButtonElement | null;
  const fullscreenLink = document.getElementById('flight-fullscreen') as HTMLAnchorElement | null;
  const headingEl = document.getElementById('flight-cta-heading');
  const summaryEl = document.getElementById('flight-summary');
  const stage1DetailEl = document.getElementById('flight-stage1-detail');
  const stage1LinkEl = document.getElementById('flight-stage1-link') as HTMLAnchorElement | null;
  const stage2DetailEl = document.getElementById('flight-stage2-detail');
  const stage2LinkEl = document.getElementById('flight-stage2-link') as HTMLAnchorElement | null;
  const stateLabel = document.getElementById('flight-state');
  const hint = document.getElementById('flight-hint');
  const targetButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-flight-target]')
  );

  let iframe: HTMLIFrameElement | null = null;

  const applyButtonClasses = (btn: HTMLButtonElement, active: boolean) => {
    btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    btn.className = active
      ? 'cursor-pointer border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-3 py-1.5 font-mono-telemetry text-[11px] tracking-[0.1em] text-[var(--color-turquoise)] uppercase transition-colors'
      : 'cursor-pointer border border-[var(--color-border)] bg-[var(--color-slate)] px-3 py-1.5 font-mono-telemetry text-[11px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase transition-colors hover:border-[var(--color-turquoise-border)] hover:text-[var(--color-text-primary)]';
  };

  const selectTarget = (target: TargetId) => {
    if (!missions || !missions[target]) return;
    const meta = missions[target];

    for (const btn of targetButtons) {
      applyButtonClasses(btn, btn.dataset.flightTarget === target);
    }

    if (headingEl) headingEl.textContent = meta.heading;
    if (summaryEl) summaryEl.textContent = meta.summary;
    if (fullscreenLink) fullscreenLink.href = meta.transitHref;
    if (stage1DetailEl) stage1DetailEl.textContent = meta.transitDetail;
    if (stage1LinkEl) stage1LinkEl.href = meta.transitHref;
    if (stage2DetailEl) stage2DetailEl.textContent = meta.landingDetail;
    if (stage2LinkEl) stage2LinkEl.href = meta.landingHref;

    if (stage) {
      stage.dataset.src = meta.transitHref;
      stage.dataset.iframeTitle = meta.iframeTitle;
    }

    if (iframe) {
      iframe.src = meta.transitHref;
      iframe.title = meta.iframeTitle;
    }
  };

  targetButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.flightTarget as TargetId | undefined;
      if (target) selectTarget(target);
    });
  });

  const setRunning = (running: boolean) => {
    if (!stage) return;
    stage.dataset.state = running ? 'running' : 'standby';
    if (stateLabel) {
      stateLabel.textContent = running ? 'Status: Uplink online' : 'Status: Mission standby';
    }
  };

  const exitMission = () => {
    iframe?.remove();
    iframe = null;
    standby?.removeAttribute('hidden');
    setRunning(false);
    if (launchBtn) {
      launchBtn.innerHTML = 'Launch mission <span aria-hidden="true">&rarr;</span>';
      launchBtn.focus();
    }
    if (hint) {
      hint.textContent =
        'Launch to load the 3D module · Back to museum inside the mission returns here';
    }
  };

  const launchMission = () => {
    if (!stage || iframe) return;
    const src = stage.dataset.src;
    if (!src) return;

    iframe = document.createElement('iframe');
    iframe.id = 'flight-iframe';
    iframe.title = stage.dataset.iframeTitle || 'Planetary flight — interactive 3D mission';
    iframe.src = src;
    iframe.className = 'h-full w-full border-0 bg-[var(--color-void)]';
    iframe.setAttribute('allow', 'fullscreen; autoplay');
    stage.appendChild(iframe);
    standby?.setAttribute('hidden', '');
    setRunning(true);

    if (launchBtn) {
      launchBtn.innerHTML = 'Exit mission <span aria-hidden="true">&times;</span>';
    }
    if (hint) {
      hint.textContent = 'Mission running · A thin bar inside the frame returns to this section';
    }
  };

  launchBtn?.addEventListener('click', () => {
    if (iframe) {
      exitMission();
    } else {
      launchMission();
    }
  });
</script>
