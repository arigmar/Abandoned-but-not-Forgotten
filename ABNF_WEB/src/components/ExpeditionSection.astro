---
import { ARTIFACT_TYPE_LABELS, formatCoordinates, type Artifact } from '../lib/archive';

interface Props {
  artifacts: Artifact[];
}

const { artifacts } = Astro.props;

const marsArtifacts = artifacts.filter((a) => a.body === 'mars');
const moonArtifacts = artifacts.filter((a) => a.body === 'moon');
const bodyGroups = [
  { key: 'mars' as const, label: 'MARS MONUMENTS', items: marsArtifacts },
  { key: 'moon' as const, label: 'MOON MONUMENTS', items: moonArtifacts },
];

const defaultArtifact = artifacts[0];
const defaultCoords = defaultArtifact
  ? formatCoordinates(defaultArtifact.site.lat, defaultArtifact.site.lon)
  : 'NO TARGET';

// Strip build-time ImageMetadata so only pure text & coordinates serialize to client
const expeditionCatalog = artifacts.map((artifact) => ({
  id: artifact.id,
  name: artifact.name,
  nssdcId: artifact.nssdcId,
  agency: artifact.agency,
  body: artifact.body,
  type: artifact.type,
  launchDate: artifact.launchDate,
  lastContactDate: artifact.lastContactDate,
  site: artifact.site,
  endCause: artifact.endCause,
  scientificValue: artifact.scientificValue,
  kidSummary: artifact.kidSummary,
  sizeFact: artifact.sizeFact,
  legacy: artifact.legacy,
  verification: artifact.verification,
  verificationNote: artifact.verificationNote,
  sources: artifact.sources,
  featured: artifact.featured,
}));
---

<section
  id="expedition"
  data-state="active"
  class="border-b border-[var(--color-border)] bg-[var(--color-void)] py-14 sm:py-18"
  aria-labelledby="expedition-heading"
>
  <div class="mx-auto max-w-7xl space-y-6 px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex flex-col gap-3 border-b border-[var(--color-border)] pb-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="font-mono-telemetry text-[11px] tracking-[0.16em] text-[var(--color-turquoise)] uppercase">
          02 // EXPEDITION · SECTION 02 / 06
        </p>
        <h2
          id="expedition-heading"
          class="mt-1.5 font-serif-display text-4xl tracking-tight text-[var(--color-text-primary)] sm:text-5xl"
        >
          Surface Expedition
        </h2>
        <p class="mt-2 max-w-2xl text-xs leading-relaxed text-[var(--color-text-secondary)] sm:text-sm">
          Fly across deep space, descend to Mars or the Moon, drive a generic survey rover to a dormant NASA monument, and inspect its exterior telemetry.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div
          class="flex items-center gap-1.5 border border-[var(--color-border)] bg-[var(--color-slate)] p-1"
          role="group"
          aria-label="Expedition reading style"
        >
          <button
            type="button"
            data-expedition-reading-mode="explorer"
            aria-pressed="true"
            class="expedition-mode-btn cursor-pointer border border-transparent px-2.5 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase transition-colors"
          >
            Explorer Mode
          </button>
          <button
            type="button"
            data-expedition-reading-mode="technical"
            aria-pressed="false"
            class="expedition-mode-btn cursor-pointer border border-transparent px-2.5 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase transition-colors"
          >
            Mission Log
          </button>
        </div>

        <span class="border border-[var(--color-border)] bg-[var(--color-slate)] px-2.5 py-1.5 font-mono-telemetry text-[10px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase">
          Exteriors Only
        </span>
      </div>
    </div>

    <!-- Step 0: Target Monument Launch Selector -->
    <div id="expedition-launch-panel" class="surface-slate space-y-5 p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-border)] pb-3">
        <div>
          <h3 class="font-mono-telemetry text-xs font-bold tracking-[0.14em] text-[var(--color-text-primary)] uppercase">
            01 // Select Target Monument (All 6 Unlocked)
          </h3>
          <p class="mt-0.5 font-mono-telemetry text-[10px] tracking-[0.08em] text-[var(--color-text-secondary)]">
            SINGLE DATA SOURCE · PICK MARS OR MOON · PROGRESS SYNCED LIVE WITH 05 // ARCHIVE
          </p>
        </div>
        <span class="border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-turquoise)] uppercase">
          Distances compressed — not to scale
        </span>
      </div>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        {
          bodyGroups.map((group) => (
            <div class="space-y-2.5">
              <p class="font-mono-telemetry text-[11px] font-bold tracking-[0.14em] text-[var(--color-text-secondary)] uppercase">
                {group.label} ({group.items.length})
              </p>
              <div class="grid grid-cols-1 gap-2.5">
                {group.items.map((artifact) => {
                  const isDefault = artifact.id === defaultArtifact?.id;
                  const coords = formatCoordinates(artifact.site.lat, artifact.site.lon);
                  return (
                    <button
                      type="button"
                      data-expedition-select={artifact.id}
                      aria-pressed={isDefault ? 'true' : 'false'}
                      class="expedition-card group flex w-full cursor-pointer flex-col gap-2 border border-[var(--color-border)] bg-[var(--color-void)] p-3.5 text-left transition-colors hover:border-[var(--color-turquoise-border)]"
                    >
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex flex-wrap items-center gap-1.5 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase">
                          <span class="border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-1.5 py-0.5 text-[var(--color-text-primary)]">
                            {ARTIFACT_TYPE_LABELS[artifact.type]}
                          </span>
                          <span>{artifact.nssdcId}</span>
                        </div>

                        <div class="flex flex-wrap items-center gap-1.5">
                          <span
                            data-expedition-discovery={artifact.id}
                            data-discovery-state="dormant"
                            class="expedition-discovery-pill border border-[var(--color-border)] bg-[var(--color-slate)] px-1.5 py-0.5 font-mono-telemetry text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-secondary)] uppercase"
                          >
                            DORMANT
                          </span>
                          {artifact.verification === 'verified' ? (
                            <span class="border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-1.5 py-0.5 font-mono-telemetry text-[9px] font-bold tracking-[0.1em] text-[var(--color-turquoise)] uppercase">
                              VERIFIED
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1 border border-[var(--color-alert-border)] bg-[var(--color-alert-dim)] px-1.5 py-0.5 font-mono-telemetry text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-primary)] uppercase">
                              <svg viewBox="0 0 16 16" class="h-3 w-3 text-[var(--color-alert)]" fill="currentColor" aria-hidden="true">
                                <path d="M8 1.5L15 14H1L8 1.5ZM7.25 6V10H8.75V6H7.25ZM7.25 11.25V12.75H8.75V11.25H7.25Z" />
                              </svg>
                              DATA TO VERIFY
                            </span>
                          )}
                        </div>
                      </div>

                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <span class="font-serif-display text-2xl leading-tight text-[var(--color-text-primary)]">
                          {artifact.name}
                        </span>
                        <span class="font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-turquoise)] opacity-0 transition-opacity group-aria-pressed:opacity-100">
                          SELECTED
                        </span>
                      </div>

                      <p class="font-mono-telemetry text-[11px] text-[var(--color-text-secondary)]">
                        {artifact.site.name} · {coords}
                      </p>

                      {artifact.sizeFact && (
                        <p class="font-mono-telemetry text-[10px] text-[var(--color-amber)]">
                          SCALE · {artifact.sizeFact}
                        </p>
                      )}
                    </button>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Launch Controls Bar -->
      <div class="flex flex-col gap-3 border-t border-[var(--color-border)] pt-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-mono-telemetry text-[10px] tracking-[0.12em] text-[var(--color-text-secondary)] uppercase">
            Active Flight Plan
          </p>
          <p
            id="expedition-selected-briefing"
            class="mt-0.5 font-mono-telemetry text-xs text-[var(--color-text-primary)]"
          >
            {defaultArtifact ? `${defaultArtifact.name} · ${defaultArtifact.site.name} (${defaultCoords})` : 'No artifact selected'}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <label class="inline-flex cursor-pointer items-center gap-2 font-mono-telemetry text-[11px] text-[var(--color-text-secondary)]">
            <input
              type="checkbox"
              id="expedition-fullscreen-toggle"
              class="h-4 w-4 accent-[var(--color-turquoise)]"
            />
            <span>Fullscreen on launch</span>
          </label>

          <button
            type="button"
            id="expedition-launch-btn"
            class="inline-flex cursor-pointer items-center justify-center gap-2 border border-[var(--color-amber)] bg-[var(--color-amber)] px-5 py-2.5 font-mono-telemetry text-xs font-bold tracking-[0.14em] text-[var(--color-void)] uppercase transition-colors hover:bg-[color:#ffb142]"
          >
            <span>Launch Expedition</span>
            <span aria-hidden="true">-&gt;</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Stage Viewport (16:9 on desktop, expands in fullscreen) -->
    <div
      id="expedition-stage"
      data-phase="standby"
      class="relative min-h-[430px] w-full overflow-hidden border border-[var(--color-border-strong)] bg-[var(--color-void)] sm:min-h-0 sm:aspect-video"
    >
      <!-- Pre-Launch Standby Overlay -->
      <div
        id="expedition-standby"
        class="flex h-full w-full flex-col justify-between bg-reticle-grid p-5 sm:p-7"
      >
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-border)] pb-3">
          <div class="flex items-center gap-2 font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-turquoise)]">
            <span class="h-2 w-2 bg-[var(--color-turquoise)]" aria-hidden="true" />
            <span>3D ENGINE STANDBY · LAZY-LOADED ON LAUNCH</span>
          </div>
          <span class="font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)]">
            PROCEDURAL EXTERIOR GEOMETRY · 60 FPS TARGET
          </span>
        </div>

        <div class="my-auto max-w-2xl space-y-3 py-6">
          <p class="font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-amber)] uppercase">
            Mission Sequence // 4 Phases
          </p>
          <h3
            id="expedition-standby-title"
            class="font-serif-display text-3xl text-[var(--color-text-primary)] sm:text-4xl"
          >
            {defaultArtifact ? `Ready for Launch: ${defaultArtifact.name}` : 'Select a Monument Above'}
          </h3>
          <p
            id="expedition-standby-summary"
            class="text-xs leading-relaxed text-[var(--color-text-secondary)] sm:text-sm"
          >
            {defaultArtifact ? defaultArtifact.kidSummary ?? defaultArtifact.scientificValue : ''}
          </p>
          <div class="grid grid-cols-1 gap-2 pt-2 font-mono-telemetry text-[10px] text-[var(--color-text-secondary)] sm:grid-cols-2">
            <div class="border border-[var(--color-border)] bg-[var(--color-slate)] px-3 py-2">
              <strong class="text-[var(--color-text-primary)]">DESKTOP:</strong> W/A/S/D or Arrows Drive · Drag Orbit · SPACE Sonar · E Scan/Hold · G Auto-Approach · ESC Pause
            </div>
            <div class="border border-[var(--color-border)] bg-[var(--color-slate)] px-3 py-2">
              <strong class="text-[var(--color-text-primary)]">TOUCH / KEYBOARD:</strong> Left Virtual Joystick · Pulse &amp; Interact Buttons · Full Keyboard Completion
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-border)] pt-3 font-mono-telemetry text-[10px] text-[var(--color-text-secondary)]">
          <span>NO INTERIORS · NO ENEMIES · NO FAIL STATES</span>
          <span class="text-[var(--color-turquoise)]">CLICK LAUNCH EXPEDITION ABOVE TO INITIALIZE 3D VIEWPORT</span>
        </div>
      </div>

      <!-- 3D Canvas (activated after Launch Expedition click) -->
      <canvas
        id="expedition-canvas"
        role="img"
        aria-label="Interactive 3D Surface Expedition viewport showing transit, landing descent, rover exploration, and exterior monument inspection"
        class="block h-full w-full outline-none"
        hidden
      ></canvas>

      <!-- Active DOM HUD Overlay (uses page CSS fonts, never canvas text) -->
      <div
        id="expedition-hud"
        hidden
        class="pointer-events-none absolute inset-0 z-10 flex flex-col justify-between p-2.5 sm:p-4"
      >
        <!-- Top HUD Bar -->
        <div class="pointer-events-auto space-y-1.5">
          <div class="flex flex-wrap items-center justify-between gap-2 border border-[var(--color-border-strong)] bg-[color:rgba(9,13,22,0.88)] px-3 py-2 backdrop-blur-xs">
            <div class="flex flex-wrap items-center gap-2">
              <span
                id="hud-phase-label"
                class="border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-2 py-0.5 font-mono-telemetry text-[10px] font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase"
              >
                PHASE 01 // TRANSIT
              </span>
              <span
                id="hud-target-name"
                class="font-serif-display text-lg leading-none text-[var(--color-text-primary)] sm:text-xl"
              ></span>
              <span
                id="hud-nssdc"
                class="hidden font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] sm:inline"
              ></span>
              <span
                id="hud-verification-badge"
                hidden
                class="inline-flex items-center gap-1 border border-[var(--color-alert-border)] bg-[var(--color-alert-dim)] px-1.5 py-0.5 font-mono-telemetry text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-primary)] uppercase"
              >
                <svg viewBox="0 0 16 16" class="h-3 w-3 text-[var(--color-alert)]" fill="currentColor" aria-hidden="true">
                  <path d="M8 1.5L15 14H1L8 1.5ZM7.25 6V10H8.75V6H7.25ZM7.25 11.25V12.75H8.75V11.25H7.25Z" />
                </svg>
                DATA TO VERIFY
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
              <span
                id="hud-scale-pill"
                class="hidden border border-[var(--color-border)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[9px] tracking-[0.06em] text-[var(--color-text-secondary)] lg:inline-block"
              >
                Distances compressed - not to scale
              </span>
              <button
                type="button"
                id="hud-skip-btn"
                class="cursor-pointer border border-[var(--color-amber-border)] bg-[var(--color-amber-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-amber)] uppercase hover:border-[var(--color-amber)]"
              >
                Skip [ENTER]
              </button>
              <button
                type="button"
                id="hud-pause-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)] hover:text-[var(--color-turquoise)]"
              >
                Pause [ESC]
              </button>
              <button
                type="button"
                id="hud-fullscreen-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)] hover:text-[var(--color-turquoise)]"
              >
                Fullscreen
              </button>
              <button
                type="button"
                id="hud-exit-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-void)] px-2 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase hover:border-[var(--color-turquoise)] hover:text-[var(--color-text-primary)]"
              >
                Exit
              </button>
            </div>
          </div>

          <!-- Site Coordinates & Distance Readout Strip -->
          <div
            id="hud-site-bar"
            class="flex flex-wrap items-center justify-between gap-2 border border-[var(--color-border)] bg-[color:rgba(19,27,46,0.84)] px-3 py-1.5 font-mono-telemetry text-[10px]"
          >
            <div class="flex flex-wrap items-center gap-2 text-[var(--color-text-primary)]">
              <span id="hud-site-name"></span>
              <span class="text-[var(--color-text-secondary)]">·</span>
              <span id="hud-site-coords" class="text-[var(--color-turquoise)]"></span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <span id="hud-distance-readout" class="text-[var(--color-text-secondary)]"></span>
              <span
                id="hud-state-badge"
                data-discovery-state="dormant"
                class="expedition-discovery-pill border border-[var(--color-border)] bg-[var(--color-void)] px-2 py-0.5 text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-secondary)] uppercase"
              >
                DORMANT
              </span>
            </div>
          </div>
        </div>

        <!-- 3D-Projected Exterior Hotspot Reticle Buttons Layer -->
        <div
          id="hud-hotspots-layer"
          class="pointer-events-none relative flex-1"
          aria-label="Monument exterior inspection points"
        ></div>

        <!-- Active Museum-Plaque Hotspot Inspection Card -->
        <div
          id="hud-plaque-card"
          hidden
          role="region"
          aria-label="Scanned monument exterior telemetry"
          class="pointer-events-auto mx-auto mb-2 w-full max-w-2xl border border-[var(--color-turquoise-border)] bg-[color:rgba(9,13,22,0.94)] p-3.5 shadow-lg sm:p-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-border)] pb-2">
            <span
              id="hud-plaque-eyebrow"
              class="font-mono-telemetry text-[10px] font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase"
            ></span>
            <div class="flex items-center gap-2">
              <span
                id="hud-plaque-mode-pill"
                class="border border-[var(--color-border)] bg-[var(--color-slate)] px-1.5 py-0.5 font-mono-telemetry text-[9px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase"
              >
                EXPLORER MODE
              </span>
              <button
                type="button"
                id="hud-plaque-close-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-0.5 font-mono-telemetry text-[10px] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)]"
              >
                Close
              </button>
            </div>
          </div>
          <h4
            id="hud-plaque-title"
            class="mt-2 font-serif-display text-2xl leading-tight text-[var(--color-text-primary)]"
          ></h4>
          <p id="hud-plaque-body" class="mt-1.5 text-xs leading-relaxed text-[var(--color-text-primary)] sm:text-sm"></p>
          <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
            <a
              id="hud-plaque-source"
              hidden
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono-telemetry text-[10px] text-[var(--color-amber)] underline underline-offset-2"
            ></a>
            <button
              type="button"
              id="hud-plaque-next-btn"
              class="ml-auto cursor-pointer border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-turquoise)] uppercase hover:border-[var(--color-turquoise)]"
            >
              Next Point [E]
            </button>
          </div>
        </div>

        <!-- Bottom Controls Bar: Surface Driving -->
        <div
          id="hud-drive-controls"
          hidden
          class="pointer-events-auto flex items-end justify-between gap-3"
        >
          <!-- Virtual Joystick for Touch / Pointer Driving -->
          <div class="flex items-center gap-2.5">
            <div
              id="expedition-joystick"
              role="application"
              aria-label="Rover steering joystick"
              class="relative flex h-24 w-24 touch-none select-none items-center justify-center rounded-full border border-[var(--color-turquoise-border)] bg-[color:rgba(9,13,22,0.82)]"
            >
              <div
                id="expedition-joystick-thumb"
                class="pointer-events-none h-9 w-9 rounded-full border border-[var(--color-turquoise)] bg-[var(--color-turquoise-dim)]"
              ></div>
            </div>
            <p class="hidden font-mono-telemetry text-[10px] leading-tight text-[var(--color-text-secondary)] sm:block">
              W/A/S/D or Arrows to Drive<br />Drag Viewport to Look
            </p>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <button
              type="button"
              id="hud-pulse-btn"
              class="cursor-pointer border border-[var(--color-turquoise)] bg-[color:rgba(9,13,22,0.9)] px-3.5 py-2 font-mono-telemetry text-[11px] font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase hover:bg-[var(--color-turquoise-dim)]"
            >
              Pulse Sonar [SPACE]
            </button>
            <button
              type="button"
              id="hud-approach-btn"
              class="cursor-pointer border border-[var(--color-amber-border)] bg-[color:rgba(9,13,22,0.9)] px-3.5 py-2 font-mono-telemetry text-[11px] font-bold tracking-[0.12em] text-[var(--color-amber)] uppercase hover:bg-[var(--color-amber-dim)]"
            >
              Auto-Approach [G]
            </button>
          </div>
        </div>

        <!-- Bottom Controls Bar: Exterior Inspection & Hold-to-Link -->
        <div
          id="hud-inspect-controls"
          hidden
          class="pointer-events-auto flex flex-col gap-2.5 border border-[var(--color-border-strong)] bg-[color:rgba(9,13,22,0.9)] p-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex flex-wrap items-center gap-2">
            <span
              id="hud-hotspot-progress"
              class="font-mono-telemetry text-[10px] font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase"
            >
              SCANNED 0 / 5 EXTERIOR POINTS
            </span>
            <div class="flex flex-wrap items-center gap-1.5">
              <button
                type="button"
                id="hud-prev-hotspot"
