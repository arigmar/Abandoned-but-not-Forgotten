---
import type { Artifact } from '../lib/archive';

interface Props {
  artifacts: Artifact[];
}

const { artifacts } = Astro.props;

// Strip build-time ImageMetadata so only pure text & coordinates serialize to client
const expeditionCatalog = artifacts.map((artifact) => ({
  id: artifact.id,
  name: artifact.name,
  nssdcId: artifact.nssdcId,
  agency: artifact.agency,
  body: artifact.body,
  type: artifact.type,
  launchDate: artifact.launchDate,
  lastContactDate: artifact.lastContactDate,
  site: artifact.site,
  endCause: artifact.endCause,
  scientificValue: artifact.scientificValue,
  kidSummary: artifact.kidSummary,
  sizeFact: artifact.sizeFact,
  legacy: artifact.legacy,
  verification: artifact.verification,
  verificationNote: artifact.verificationNote,
  sources: artifact.sources,
  featured: artifact.featured,
}));
---

<section
  id="expedition"
  data-state="active"
  class="border-b border-[var(--color-border)] bg-[var(--color-void)] py-14 sm:py-18"
  aria-labelledby="expedition-heading"
>
  <div class="mx-auto max-w-7xl space-y-6 px-4 sm:px-6">
    <!-- Section Header -->
    <div class="flex flex-col gap-3 border-b border-[var(--color-border)] pb-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="font-mono-telemetry text-[11px] tracking-[0.16em] text-[var(--color-turquoise)] uppercase">
          02 // SPACE &amp; SURFACE SIMULATOR · SECTION 02 / 06
        </p>
        <h2
          id="expedition-heading"
          class="mt-1.5 font-serif-display text-4xl tracking-tight text-[var(--color-text-primary)] sm:text-5xl"
        >
          Orbital Flight &amp; Surface Explorer
        </h2>
        <p class="mt-2 max-w-2xl text-xs leading-relaxed text-[var(--color-text-secondary)] sm:text-sm">
          Start in open deep space between Earth, the Moon, and Mars. Land under real gravity, deploy your rover to inspect dormant monuments nearby, or blast back off into orbit to explore another world.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div
          class="flex items-center gap-1.5 border border-[var(--color-border)] bg-[var(--color-slate)] p-1"
          role="group"
          aria-label="Expedition reading style"
        >
          <button
            type="button"
            data-expedition-reading-mode="explorer"
            aria-pressed="true"
            class="expedition-mode-btn cursor-pointer border border-transparent px-2.5 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase transition-colors"
          >
            Explorer Mode
          </button>
          <button
            type="button"
            data-expedition-reading-mode="technical"
            aria-pressed="false"
            class="expedition-mode-btn cursor-pointer border border-transparent px-2.5 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase transition-colors"
          >
            Mission Log
          </button>
        </div>

        <span class="border border-[var(--color-border)] bg-[var(--color-slate)] px-2.5 py-1.5 font-mono-telemetry text-[10px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase">
          Unified 3D Engine
        </span>
      </div>
    </div>

    <!-- Main Unified 3D Viewport (Spaceflight -> Powered Landing -> Surface Rover -> Liftoff to Orbit) -->
    <div
      id="expedition-stage"
      data-phase="standby"
      class="relative min-h-[460px] w-full overflow-hidden border border-[var(--color-border-strong)] bg-[var(--color-void)] sm:min-h-0 sm:aspect-video"
    >
      <!-- Pre-Launch Standby Overlay -->
      <div
        id="expedition-standby"
        class="flex h-full w-full flex-col justify-between bg-reticle-grid p-5 sm:p-7"
      >
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-border)] pb-3">
          <div class="flex items-center gap-2 font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-turquoise)]">
            <span class="h-2 w-2 bg-[var(--color-turquoise)]" aria-hidden="true" />
            <span>3D SPACE SIMULATOR · UNIFIED ORBIT &amp; SURFACE</span>
          </div>
          <span class="font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)]">
            EARTH &middot; MOON (1.62 M/S&sup2;) &middot; MARS (3.72 M/S&sup2;)
          </span>
        </div>

        <div class="my-auto max-w-2xl space-y-4 py-4">
          <p class="font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-amber)] uppercase">
            Main Flight Simulator // Open Interplanetary Transit
          </p>
          <h3
            id="expedition-standby-title"
            class="font-serif-display text-3xl text-[var(--color-text-primary)] sm:text-4xl"
          >
            Interplanetary Space &amp; Surface Simulator
          </h3>
          <p
            id="expedition-standby-summary"
            class="text-xs leading-relaxed text-[var(--color-text-secondary)] sm:text-sm"
          >
            Fly from Earth orbit to the Moon or Mars, touch down on the landing apron, and drive your miniature rover to all historical monuments placed in their real planetary zones.
          </p>

          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            <button
              type="button"
              id="expedition-standby-launch-btn"
              class="inline-flex cursor-pointer items-center justify-center gap-2 border border-[var(--color-amber)] bg-[var(--color-amber)] px-5 py-2.5 font-mono-telemetry text-xs font-bold tracking-[0.14em] text-[var(--color-void)] uppercase transition-colors hover:bg-[color:#ffb142]"
            >
              <span>Launch Space Simulator</span>
              <span aria-hidden="true">-&gt;</span>
            </button>
            <button
              type="button"
              id="expedition-standby-surface-btn"
              data-expedition-deploy-body="mars"
              class="inline-flex cursor-pointer items-center justify-center gap-2 border border-[var(--color-amber-border)] bg-[var(--color-amber-dim)] px-4 py-2.5 font-mono-telemetry text-xs font-bold tracking-[0.12em] text-[var(--color-amber)] uppercase transition-colors hover:border-[var(--color-amber)]"
            >
              <span>Deploy Mars (3 Sites)</span>
            </button>
            <button
              type="button"
              data-expedition-deploy-body="moon"
              class="inline-flex cursor-pointer items-center justify-center gap-2 border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-4 py-2.5 font-mono-telemetry text-xs font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase transition-colors hover:border-[var(--color-turquoise)]"
            >
              <span>Deploy Moon (3 Sites)</span>
            </button>
          </div>

          <div class="grid grid-cols-1 gap-2 pt-1 font-mono-telemetry text-[10px] text-[var(--color-text-secondary)] sm:grid-cols-2">
            <div class="border border-[var(--color-border)] bg-[var(--color-slate)] px-3 py-2">
              <strong class="text-[var(--color-text-primary)]">FLIGHT &amp; LANDING:</strong> W/Space Thrust &middot; WASD/Arrows Steer &middot; [1]/[2] Moon/Mars &middot; G Auto-Cruise/Land &middot; R Retry
            </div>
            <div class="border border-[var(--color-border)] bg-[var(--color-slate)] px-3 py-2">
              <strong class="text-[var(--color-text-primary)]">SURFACE &amp; ORBIT RETURN:</strong> Touch down -> [E] Explore Surface or [L] Launch to Orbit anytime from rover or pad
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[var(--color-border)] pt-3 font-mono-telemetry text-[10px] text-[var(--color-text-secondary)]">
          <span>ONE SEAMLESS ENGINE · ZERO MONUMENT LOCK-INS</span>
          <label class="inline-flex cursor-pointer items-center gap-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]">
            <input
              type="checkbox"
              id="expedition-fullscreen-toggle"
              class="h-3.5 w-3.5 accent-[var(--color-turquoise)]"
            />
            <span>Fullscreen on launch</span>
          </label>
          <span class="text-[var(--color-turquoise)]">ALL 3 MARS &amp; ALL 3 MOON SITES SPAWN ON THEIR REAL ZONES</span>
        </div>
      </div>

      <!-- 3D Canvas (activated after Launch click) -->
      <canvas
        id="expedition-canvas"
        role="img"
        aria-label="Interactive 3D orbital flight, powered planetary landing, rover surface exploration, and liftoff to orbit viewport"
        class="block h-full w-full outline-none"
        hidden
      ></canvas>

      <!-- Active DOM HUD Overlay (uses page CSS fonts, never canvas text) -->
      <div
        id="expedition-hud"
        hidden
        class="pointer-events-none absolute inset-0 z-10 flex flex-col justify-between p-2.5 sm:p-4"
      >
        <!-- Top HUD Bar -->
        <div class="pointer-events-auto relative z-20 space-y-1.5">
          <div class="flex flex-wrap items-center justify-between gap-2 border border-[var(--color-border-strong)] bg-[color:rgba(9,13,22,0.88)] px-3 py-2 backdrop-blur-xs">
            <div class="flex flex-wrap items-center gap-2">
              <span
                id="hud-phase-label"
                class="border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-2 py-0.5 font-mono-telemetry text-[10px] font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase"
              >
                PHASE 01 // SPACE FLIGHT
              </span>
              <span
                id="hud-target-name"
                class="font-serif-display text-lg leading-none text-[var(--color-text-primary)] sm:text-xl"
              ></span>
              <span
                id="hud-nssdc"
                class="hidden font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] sm:inline"
              ></span>
              <span
                id="hud-verification-badge"
                hidden
                class="inline-flex items-center gap-1 border border-[var(--color-alert-border)] bg-[var(--color-alert-dim)] px-1.5 py-0.5 font-mono-telemetry text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-primary)] uppercase"
              >
                <svg viewBox="0 0 16 16" class="h-3 w-3 text-[var(--color-alert)]" fill="currentColor" aria-hidden="true">
                  <path d="M8 1.5L15 14H1L8 1.5ZM7.25 6V10H8.75V6H7.25ZM7.25 11.25V12.75H8.75V11.25H7.25Z" />
                </svg>
                DATA TO VERIFY
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
              <span
                id="hud-scale-pill"
                class="hidden border border-[var(--color-border)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[9px] tracking-[0.06em] text-[var(--color-text-secondary)] lg:inline-block"
              >
                Distances compressed - not to scale
              </span>
              <div id="hud-target-switch" hidden class="inline-flex items-center gap-1">
                <button
                  type="button"
                  id="hud-target-moon"
                  class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.08em] text-[var(--color-turquoise)] uppercase hover:border-[var(--color-turquoise)]"
                >
                  Moon [1]
                </button>
                <button
                  type="button"
                  id="hud-target-mars"
                  class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.08em] text-[var(--color-amber)] uppercase hover:border-[var(--color-amber)]"
                >
                  Mars [2]
                </button>
              </div>
              <button
                type="button"
                id="hud-assist-btn"
                hidden
                class="cursor-pointer border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-turquoise)] uppercase hover:border-[var(--color-turquoise)]"
              >
                Auto-Cruise [G]
              </button>
              <button
                type="button"
                id="hud-retry-btn"
                hidden
                class="cursor-pointer border border-[var(--color-alert)] bg-[var(--color-alert-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-text-primary)] uppercase"
              >
                Retry Landing [R]
              </button>
              <button
                type="button"
                id="hud-orbit-btn"
                hidden
                class="cursor-pointer border border-[var(--color-amber-border)] bg-[var(--color-amber-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-amber)] uppercase hover:border-[var(--color-amber)]"
              >
                Launch to Orbit [L]
              </button>
              <button
                type="button"
                id="hud-skip-btn"
                class="cursor-pointer border border-[var(--color-amber-border)] bg-[var(--color-amber-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-amber)] uppercase hover:border-[var(--color-amber)]"
              >
                Skip [ENTER]
              </button>
              <button
                type="button"
                id="hud-pause-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)] hover:text-[var(--color-turquoise)]"
              >
                Pause [ESC]
              </button>
              <button
                type="button"
                id="hud-fullscreen-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)] hover:text-[var(--color-turquoise)]"
              >
                Fullscreen
              </button>
              <button
                type="button"
                id="hud-exit-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-void)] px-2 py-1 font-mono-telemetry text-[10px] tracking-[0.1em] text-[var(--color-text-secondary)] uppercase hover:border-[var(--color-turquoise)] hover:text-[var(--color-text-primary)]"
              >
                Exit
              </button>
            </div>
          </div>

          <!-- Site Coordinates & Distance Readout Strip -->
          <div
            id="hud-site-bar"
            class="flex flex-wrap items-center justify-between gap-2 border border-[var(--color-border)] bg-[color:rgba(19,27,46,0.84)] px-3 py-1.5 font-mono-telemetry text-[10px]"
          >
            <div class="flex flex-wrap items-center gap-2 text-[var(--color-text-primary)]">
              <span id="hud-site-name"></span>
              <span class="text-[var(--color-text-secondary)]">&middot;</span>
              <span id="hud-site-coords" class="text-[var(--color-turquoise)]"></span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <span id="hud-distance-readout" class="text-[var(--color-text-secondary)]"></span>
              <span
                id="hud-state-badge"
                data-discovery-state="dormant"
                class="expedition-discovery-pill border border-[var(--color-border)] bg-[var(--color-void)] px-2 py-0.5 text-[9px] font-bold tracking-[0.1em] text-[var(--color-text-secondary)] uppercase"
              >
                DORMANT
              </span>
            </div>
          </div>
        </div>

        <!-- 3D-Projected Exterior Hotspot Reticle Buttons Layer (full viewport aligned to canvas) -->
        <div
          id="hud-hotspots-layer"
          class="pointer-events-none absolute inset-0 z-10 overflow-hidden"
          aria-label="Monument exterior inspection points"
        ></div>

        <!-- Flex spacer keeping bottom HUD panels docked without shifting projected reticle coordinates -->
        <div class="pointer-events-none flex-1" aria-hidden="true"></div>

        <!-- Touchdown / Recovery Decision Card (stays inside the same 3D viewport after landing) -->
        <div
          id="hud-touchdown-card"
          hidden
          role="region"
          aria-label="Planetary touchdown options"
          class="pointer-events-auto relative z-20 mx-auto mb-2 w-full max-w-2xl border border-[var(--color-turquoise-border)] bg-[color:rgba(9,13,22,0.92)] p-4 shadow-lg backdrop-blur-xs sm:p-5"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-border)] pb-2">
            <span
              id="hud-touchdown-eyebrow"
              class="font-mono-telemetry text-[10px] font-bold tracking-[0.14em] text-[var(--color-turquoise)] uppercase"
            >
              TOUCHDOWN CONFIRMED
            </span>
            <span class="font-mono-telemetry text-[9px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase">
              SURFACE READY
            </span>
          </div>
          <h4
            id="hud-touchdown-title"
            class="mt-2 font-serif-display text-2xl leading-tight text-[var(--color-text-primary)] sm:text-3xl"
          ></h4>
          <p
            id="hud-touchdown-body"
            class="mt-1.5 text-xs leading-relaxed text-[var(--color-text-secondary)] sm:text-sm"
          ></p>
          <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
            <button
              type="button"
              id="hud-touchdown-explore-btn"
              class="cursor-pointer border border-[var(--color-turquoise)] bg-[var(--color-turquoise)] px-4 py-2 font-mono-telemetry text-xs font-bold tracking-[0.12em] text-[var(--color-void)] uppercase transition-colors hover:bg-[color:#3ad8c9]"
            >
              Explore Surface (Rover) [E]
            </button>
            <button
              type="button"
              id="hud-touchdown-orbit-btn"
              class="cursor-pointer border border-[var(--color-amber-border)] bg-[var(--color-amber-dim)] px-4 py-2 font-mono-telemetry text-xs font-bold tracking-[0.12em] text-[var(--color-amber)] uppercase hover:border-[var(--color-amber)]"
            >
              Launch to Orbit [L]
            </button>
            <button
              type="button"
              id="hud-touchdown-retry-btn"
              class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-3.5 py-2 font-mono-telemetry text-xs tracking-[0.1em] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)]"
            >
              Retry Descent [R]
            </button>
          </div>
        </div>

        <!-- Active Interactive Subsystem Diagnostic & Plaque Card -->
        <div
          id="hud-plaque-card"
          hidden
          role="region"
          aria-label="Interactive monument subsystem diagnostics"
          class="pointer-events-auto relative z-20 mx-auto mb-2 w-full max-w-2xl border border-[var(--color-turquoise-border)] bg-[color:rgba(9,13,22,0.95)] p-3.5 shadow-lg sm:p-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--color-border)] pb-2">
            <div class="flex flex-wrap items-center gap-2">
              <span
                id="hud-plaque-eyebrow"
                class="font-mono-telemetry text-[10px] font-bold tracking-[0.12em] text-[var(--color-turquoise)] uppercase"
              ></span>
              <div id="hud-plaque-tabs" class="inline-flex items-center gap-1" role="group" aria-label="Subsystems 1 to 5"></div>
            </div>
            <div class="flex items-center gap-1.5">
              <span
                id="hud-plaque-mode-pill"
                class="border border-[var(--color-border)] bg-[var(--color-slate)] px-1.5 py-0.5 font-mono-telemetry text-[9px] tracking-[0.08em] text-[var(--color-text-secondary)] uppercase"
              >
                EXPLORER MODE
              </span>
              <button
                type="button"
                id="hud-plaque-close-btn"
                class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-2 py-0.5 font-mono-telemetry text-[10px] text-[var(--color-text-primary)] uppercase hover:border-[var(--color-turquoise)]"
              >
                Close
              </button>
            </div>
          </div>

          <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-[1.35fr_1fr] sm:items-start">
            <div>
              <h4
                id="hud-plaque-title"
                class="font-serif-display text-2xl leading-tight text-[var(--color-text-primary)]"
              ></h4>
              <p id="hud-plaque-body" class="mt-1.5 text-xs leading-relaxed text-[var(--color-text-primary)] sm:text-sm"></p>
            </div>

            <!-- Live Subsystem Waveform & Nominal/Shutdown Comparator -->
            <div class="border border-[var(--color-border)] bg-[var(--color-void)] p-2.5">
              <div class="flex items-center justify-between gap-2 font-mono-telemetry text-[9px] tracking-[0.08em] uppercase">
                <span id="hud-plaque-metric-label" class="text-[var(--color-text-secondary)]"></span>
                <button
                  type="button"
                  id="hud-plaque-sim-toggle"
                  class="cursor-pointer border border-[var(--color-border-strong)] bg-[var(--color-slate)] px-1.5 py-0.5 text-[var(--color-amber)] hover:border-[var(--color-amber)]"
                >
                  NOMINAL OPS
                </button>
              </div>
              <p id="hud-plaque-metric-value" class="mt-1 font-mono-telemetry text-xs font-bold text-[var(--color-turquoise)]"></p>
              <div id="hud-plaque-wave" class="mt-1.5 h-10 w-full overflow-hidden border border-[var(--color-border)] bg-[color:rgba(19,27,46,0.5)]"></div>
            </div>
          </div>

          <p
            id="hud-plaque-test-result"
            hidden
            class="mt-2 border border-[var(--color-amber-border)] bg-[var(--color-amber-dim)] px-2.5 py-1.5 font-mono-telemetry text-[10px] leading-snug text-[var(--color-text-primary)]"
          ></p>

          <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
            <a
              id="hud-plaque-source"
              hidden
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono-telemetry text-[10px] text-[var(--color-amber)] underline underline-offset-2"
            ></a>
            <div class="ml-auto flex flex-wrap items-center gap-1.5">
              <button
                type="button"
                id="hud-plaque-test-btn"
                class="cursor-pointer border border-[var(--color-amber)] bg-[var(--color-amber-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-amber)] uppercase hover:bg-[var(--color-amber)] hover:text-[var(--color-void)]"
              >
                Run Hardware Test [F]
              </button>
              <button
                type="button"
                id="hud-plaque-next-btn"
                class="cursor-pointer border border-[var(--color-turquoise-border)] bg-[var(--color-turquoise-dim)] px-2.5 py-1 font-mono-telemetry text-[10px] font-bold tracking-[0.1em] text-[var(--color-turquoise)] uppercase hover:border-[var(--color-turquoise)]"
              >
                Next Point [E]
              </button>
            </div>
          </div>
        </div>

        <!-- Bottom Controls Bar: Surface Driving -->
        <div
          id="hud-drive-controls"
          hidden
          class="pointer-events-auto relative z-20 flex items-end justify-between gap-3"
        >
          <!-- Virtual Joystick for Touch / Pointer Driving -->
          <div class="flex items-center gap-2.5">
            <div
              id="expedition-joystick"
              role="application"
              aria-label="Rover steering joystick"
              class="relative flex h-24 w-24 touch-none select-none items-center justify-center rounded-full border border-[var(--color-turquoise-border)] bg-[color:rgba(9,13,22,0.82)]"
            >
              <div
