---
interface Props {
  id: string;
  number: string;
  title: string;
  description: string;
  state?: 'pending' | 'active';
}

const { id, number, title, description, state = 'pending' } = Astro.props;
const hasChildren = Astro.slots.has('default');
const isActive = state === 'active';
---

<section
  id={id}
  data-state={state}
  class:list={[
    'relative border-b border-[var(--color-border)] bg-[var(--color-void)] py-14 sm:py-16',
    !hasChildren && 'flex min-h-[40vh] items-center',
  ]}
>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <div class="surface-slate p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-border)] pb-4">
        <div class="flex items-center gap-3">
          <span class="border border-[var(--color-border-strong)] bg-[var(--color-void)] px-2.5 py-1 font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-text-secondary)]">
            SECTION {number} / 06
          </span>
          <span class="font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-turquoise)]">
            {isActive
              ? `SURFACE UPLINK · ${number}/06 · TELEMETRY ONLINE`
              : `INCOMING TRANSMISSION · ${number}/06 · AWAITING UPLINK`}
          </span>
        </div>

        <div class="flex items-center gap-2.5">
          <span class="font-mono-telemetry text-[11px] tracking-[0.14em] text-[var(--color-text-secondary)] uppercase">
            {isActive ? 'Status: Uplink Active' : 'Status: Awaiting Uplink'}
          </span>
          <div
            class="relative h-1.5 w-24 overflow-hidden border border-[var(--color-border)] bg-[var(--color-void)]"
            aria-hidden="true"
          >
            {isActive ? (
              <div class="h-full w-full bg-[var(--color-turquoise)]"></div>
            ) : (
              <div class="pending-radar-bar h-full w-1/3 bg-[var(--color-turquoise)]"></div>
            )}
          </div>
        </div>
      </div>

      <div class="mt-5 flex flex-col gap-2">
        <h2 class="font-serif-display text-3xl tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
          {title}
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[var(--color-text-secondary)] sm:text-base">
          {description}
        </p>
      </div>

      {hasChildren && <div class="mt-6 border-t border-[var(--color-border)] pt-6"><slot /></div>}
    </div>
  </div>
</section>
