---
import '../styles/global.css';
import '../styles/game.css';
import { SITE } from '../config/site';
import { withBase } from '../lib/base-path';

interface Props {
  /** Mission title shown in the top bar, e.g. "Flight to Mars". */
  title: string;
  /** Telemetry code shown above the title, e.g. "FLIGHT MISSION / 03". */
  code: string;
  /** Document title suffix. */
  description: string;
  /** In-museum anchor used by the "Back to museum" link. */
  returnAnchor?: string;
  /** Top-bar quick controls preset. */
  controlsMode?: 'transit' | 'landing';
}

const {
  title,
  code,
  description,
  returnAnchor = '#expedition',
  controlsMode,
} = Astro.props;

const backHref = withBase(`/${returnAnchor}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase('/favicon.svg')}
    />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} — {SITE.name}</title>
  </head>
  <body>
    <div class="mission-shell" id="mission-shell" data-embedded="false">
      <header class="mission-bar">
        <!-- target="_top" also works when the game runs inside an iframe:
             it returns the visitor to the museum instead of navigating the frame. -->
        <a class="mission-bar__back" href={backHref} target="_top">
          <span aria-hidden="true">&larr;</span> Back to museum
        </a>

        <div class="mission-bar__identity">
          <span class="mission-bar__code">{code}</span>
          <h1 class="mission-bar__title">{title}</h1>
        </div>

        <div class="mission-bar__actions">
          {
            controlsMode === 'transit' && (
              <div class="flex items-center gap-1" role="group" aria-label="Switch destination target">
                <button
                  type="button"
                  class="mission-bar__pill"
                  data-target-btn="moon"
                  aria-pressed="false"
                >
                  Moon [1]
                </button>
                <button
                  type="button"
                  class="mission-bar__pill"
                  data-target-btn="mars"
                  aria-pressed="false"
                >
                  Mars [2]
                </button>
              </div>
            )
          }
          {
            controlsMode === 'landing' && (
              <>
                <button type="button" class="mission-bar__explore" id="mission-explore-surface">
                  Explore Surface [E]
                </button>
                <button type="button" class="mission-bar__orbit" id="mission-launch-orbit">
                  Launch to Orbit [L]
                </button>
              </>
            )
          }
          <button type="button" class="mission-bar__restart" id="mission-restart">
            Restart
          </button>
        </div>
      </header>

      <main
        id="juego"
        class="mission-viewport"
        tabindex="0"
        aria-label={`${title} interactive 3D mission`}
      >
        <div class="game-hud">
          <div class="game-hud__telemetry" id="hud-telemetry"></div>
          <!-- Only mission state changes are announced, never per-frame telemetry. -->
          <div
            class="game-hud__status"
            id="hud-status"
            role="status"
            aria-live="polite"
          ></div>
        </div>
        <slot />
      </main>
    </div>

    <script>
      const shell = document.getElementById('mission-shell');
      const viewport = document.getElementById('juego');
      const targetButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-target-btn]')
      );

      // Compact chrome when running inside the museum page.
      if (shell && window.self !== window.top) {
        shell.dataset.embedded = 'true';
      }

      document.getElementById('mission-restart')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('mission:restart'));
        viewport?.focus();
      });

      document.getElementById('mission-launch-orbit')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('mission:launch-orbit'));
        viewport?.focus();
      });

      document.getElementById('mission-explore-surface')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('mission:explore-surface'));
        viewport?.focus();
      });

      targetButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.targetBtn;
          if (!target) return;
          window.dispatchEvent(
            new CustomEvent('mission:select-target', { detail: { target } })
          );
          viewport?.focus();
        });
      });

      window.addEventListener('mission:target-changed', (e) => {
        const active = (e as CustomEvent<{ target?: string }>).detail?.target;
        targetButtons.forEach((btn) => {
          btn.setAttribute('aria-pressed', btn.dataset.targetBtn === active ? 'true' : 'false');
        });
      });
    </script>
  </body>
</html>
